@page "/"

<div class="shikaku-page">
    <main class="game-shell" style="--cols:@Board.ColsNumber; --rows:@Board.RowsNumber">
        <section class="control-bar" aria-label="Ustawienia gry">
            <label>
                Rozmiar
                <select @bind="SelectedBoardSizeKey">
                    @foreach (var size in BoardSizes)
                    {
                        <option value="@size.Key">@size.Label</option>
                    }
                </select>
            </label>

            <label>
                Trudność
                <select @bind="SelectedDifficultyKey">
                    @foreach (var difficulty in DifficultyLevels)
                    {
                        <option value="@difficulty.Key">@difficulty.Label</option>
                    }
                </select>
            </label>

            <button class="primary-action" type="button" @onclick="StartNewGame">Nowa</button>
            <button type="button" @onclick="RevealOneRect">Podpowiedź</button>
            <button type="button" @onclick="ClearBoard">Wyczyść</button>
        </section>

        <section class="mobile-play-help" aria-live="polite">
            <span class="mobile-help-icon" aria-hidden="true">☝️</span>
            <span>@MobileSelectionMessage</span>
            @if (TapStartCell is not null)
            {
                <button class="cancel-selection" type="button" @onclick="CancelTapSelection">Anuluj wybór</button>
            }
        </section>

        <section class="board-card" aria-label="Plansza Shikaku">
            <div class="shikaku-board" @onpointerleave="HandleBoardPointerLeave">
                @foreach (var row in Board.Grid)
                {
                    foreach (var cell in row)
                    {
                        <button class="shikaku-cell @cell.CssClass"
                                type="button"
                                title="@cell.Title"
                                aria-label="@cell.Title"
                                @onpointerdown="args => HandlePointerDown(args, cell)"
                                @onpointerenter="args => HandlePointerEnter(args, cell)"
                                @onpointerup="args => HandlePointerUp(args, cell)"
                                @onpointercancel="HandlePointerCancel">
                            @if (cell.Clue is not null)
                            {
                                <span class="clue">@cell.Clue.Area</span>
                            }
                        </button>
                    }
                }

                @if (CurrentRect is not null)
                {
                    <div class="current-rect-label"
                         style="--rect-x:@CurrentRect.LeftUpCornerY; --rect-y:@CurrentRect.LeftUpCornerX; --rect-cols:@CurrentRect.ColsNumber; --rect-rows:@CurrentRect.RowsNumber;">
                        <span>@CurrentRect.RowsNumber×@CurrentRect.ColsNumber</span>
                    </div>
                }
            </div>
        </section>
    </main>

    @if (IsSolved)
    {
        <div class="win-overlay" role="dialog" aria-modal="true" aria-labelledby="win-title">
            <div class="win-card">
                <span class="win-emoji" aria-hidden="true">🎉</span>
                <h2 id="win-title">Wygrana!</h2>
                <img src="sigma.png"
                     alt="Sigma"
                     style="display:block; width:min(100%, 320px); max-height:50dvh; object-fit:contain; margin:0.75rem auto 1.25rem;" />
                <button class="primary-action restart-action" type="button" @onclick="StartNewGame">Zacznij ponownie</button>
            </div>
        </div>
    }
</div>